<resources>
    <!-- API 21+：使用 Material 主题并恢复高版本属性 -->
    <style name="Theme.Xcertplay" parent="android:Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#A6C8FF</item>
        <item name="android:navigationBarColor">#0C111B</item>
        <item name="android:statusBarColor">#0C111B</item>
        <item name="android:windowBackground">@color/window_background_dark</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Theme.AdbCluster" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowDisablePreview">true</item>
    </style>
    <!-- AppDialogs 对话框主题（v21 用 Material 恢复 colorAccent，对应 main #422） -->
    <style name="Theme.Xcertplay.Dialog.Dark" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#A6C8FF</item>
        <item name="android:windowBackground">@color/dialog_background_dark</item>
    </style>
    <!-- main B8：浅色启动主题 Material 版，主活动仍用深色 Theme.Xcertplay 后由代码动态调色（作者：TRAE AI） -->
    <style name="Theme.Xcertplay.Light" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#245A9C</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:navigationBarColor">#E9EEF6</item>
        <item name="android:statusBarColor">#E9EEF6</item>
        <item name="android:windowBackground">@color/window_background_light</item>
    </style>
    <style name="Theme.Xcertplay.Dialog.Light" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#245A9C</item>
        <item name="android:windowBackground">@color/dialog_background_light</item>
    </style>
</resources>
