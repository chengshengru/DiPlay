<resources>
    <!-- API 17 基线：Theme.Material 是 API 21+，低版本回退 Holo。
         高版本属性（colorAccent/windowLightStatusBar/navigationBarColor/statusBarColor）
         放到 values-v21/themes.xml 覆盖。 -->
    <style name="Theme.Xcertplay" parent="android:Theme.Holo.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">#0C111B</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Theme.AdbCluster" parent="android:Theme.Holo.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowDisablePreview">true</item>
    </style>
    <!-- AppDialogs 取色用：API 17 基线走公开的 Holo Dialog（Theme.Holo.Dialog.Alert 为私有资源，
         AAPT2 链接会报 private；按钮排版由 AlertDialog 自身决定，v21 覆盖为 Material Alert） -->
    <style name="Theme.Xcertplay.Dialog.Dark" parent="android:Theme.Holo.Dialog">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">#151E2C</item>
    </style>
    <style name="Theme.Xcertplay.Dialog.Light" parent="android:Theme.Holo.Light.Dialog">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">#F8FAFD</item>
    </style>
</resources>
