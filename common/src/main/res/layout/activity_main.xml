<?xml version="1.0" encoding="utf-8"?>
<!-- API 17 迁移：Compose 诊断页改为 View 布局 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/main_board_i2c_title"
        android:textSize="18sp" />

    <EditText
        android:id="@+id/device_path"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/main_board_i2c_hint"
        android:inputType="text"
        android:singleLine="true"
        android:text="/dev/i2c-1"
        android:importantForAutofill="no" />

    <Button
        android:id="@+id/run_self_check"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/main_run_self_check" />

    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/main_ch341_note" />

</LinearLayout>
